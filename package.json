{
  "name": "c-oneclick-debug",
  "displayName": "C/C++ 一键调试",
  "description": "为 C / C++ 文件一键生成 tasks.json / launch.json，支持自动断点调试与直接运行，开箱即用。",
  "version": "0.5.0",
  "publisher": "woodendrifter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WoodenDrifter/c-oneclick-debug.git"
  },
  "bugs": {
    "url": "https://github.com/WoodenDrifter/c-oneclick-debug/issues"
  },
  "homepage": "https://github.com/WoodenDrifter/c-oneclick-debug#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "keywords": [
    "c",
    "gcc",
    "gdb",
    "mingw",
    "debug",
    "run",
    "tasks",
    "launch",
    "cpp",
    "c++"
  ],
  "icon": "media/icon.png",
  "main": "./src/extension.js",
  "extensionDependencies": [
    "ms-vscode.cpptools"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onCommand:cDebug.run",
    "onCommand:cDebug.debugRun",
    "onCommand:cDebug.debug",
    "onCommand:cDebug.generateAll",
    "onCommand:cDebug.panel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cDebug.run",
        "title": "运行（跑到结束）",
        "category": "C/C++",
        "icon": "$(play)"
      },
      {
        "command": "cDebug.debugRun",
        "title": "调试（直接到底）",
        "category": "C/C++",
        "icon": "$(debug)"
      },
      {
        "command": "cDebug.debug",
        "title": "断点调试",
        "category": "C/C++",
        "icon": "$(debug-alt)"
      },
      {
        "command": "cDebug.generateAll",
        "title": "生成配置文件",
        "category": "C/C++",
        "icon": "$(gear)"
      },
      {
        "command": "cDebug.panel",
        "title": "打开 C/C++ 菜单",
        "category": "C/C++",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cDebug.run",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cDebug@1"
        },
        {
          "command": "cDebug.debugRun",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cDebug@2"
        },
        {
          "command": "cDebug.debug",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cDebug@3"
        },
        {
          "command": "cDebug.generateAll",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "cDebug@4"
        }
      ],
      "explorer/context": [
        {
          "command": "cDebug.run",
          "when": "resourceExtname == .c || resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "group": "cDebug@1"
        },
        {
          "command": "cDebug.debugRun",
          "when": "resourceExtname == .c || resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "group": "cDebug@2"
        },
        {
          "command": "cDebug.debug",
          "when": "resourceExtname == .c || resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "group": "cDebug@3"
        },
        {
          "command": "cDebug.generateAll",
          "when": "resourceExtname == .c || resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "group": "cDebug@4"
        }
      ],
      "commandPalette": [
        {
          "command": "cDebug.run"
        },
        {
          "command": "cDebug.debugRun"
        },
        {
          "command": "cDebug.debug"
        },
        {
          "command": "cDebug.generateAll"
        }
      ]
    },
    "configuration": {
      "title": "C/C++ 一键调试",
      "properties": {
        "cDebug.buildMode": {
          "type": "string",
          "enum": [
            "currentFile",
            "folder"
          ],
          "enumDescriptions": [
            "只编译当前打开的源文件（单文件练习最常用）",
            "编译工作区目录下所有同类源文件并链接成一个可执行文件（多文件项目）"
          ],
          "default": "currentFile",
          "markdownDescription": "编译范围。`currentFile` 编译当前文件；`folder` 编译工作区内全部同类源码（C 用 .c，C++ 用 .cpp/.cc/.cxx）。"
        },
        "cDebug.compilerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "编译器绝对路径。留空自动探测：C 文件找 `gcc`、C++ 文件找 `g++`（其次 clang / clang++），会依次查找 PATH 与常见 MinGW/MSYS2 安装位置。"
        },
        "cDebug.debuggerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "调试器（gdb）绝对路径，写入 launch.json 的 `miDebuggerPath`。留空自动探测（优先取与 gcc 同目录的 gdb）。"
        },
        "cDebug.compilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-g",
            "-O0",
            "-Wall",
            "-Wextra"
          ],
          "markdownDescription": "编译参数。默认 `-g -O0` 保证可调试。"
        },
        "cDebug.programArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "程序运行参数（运行与调试都会带上）。"
        },
        "cDebug.externalConsole": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "调试时是否使用外部控制台窗口（调试模式下需要 `scanf` 输入时建议开启）。"
        },
        "cDebug.buildBeforeDebug": {
          "type": "boolean",
          "default": true,
          "description": "调试前自动编译一次。"
        },
        "cDebug.autoBreakpoint": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "开始调试时自动在 `main` 函数处设置断点。"
        },
        "cDebug.breakpointMode": {
          "type": "string",
          "enum": [
            "keep",
            "once"
          ],
          "enumDescriptions": [
            "断点保留在编辑器里，下次调试仍然有效",
            "程序在 main 停住后自动移除该断点（一次性）"
          ],
          "default": "keep",
          "description": "自动断点的生命周期。"
        },
        "cDebug.autoBreakpointScope": {
          "type": "string",
          "enum": [
            "managed",
            "all"
          ],
          "enumDescriptions": [
            "只对本扩展生成/托管的启动配置生效，不影响你自己的 launch.json 配置",
            "对所有 cppdbg 启动配置生效"
          ],
          "default": "managed",
          "description": "自动断点的作用范围。"
        },
        "cDebug.autoGenerateConfig": {
          "type": "boolean",
          "default": true,
          "description": "运行时若缺少 .vscode/tasks.json 或 launch.json，自动生成。"
        },
        "cDebug.syncConfigOnDebug": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "运行/调试时按当前设置刷新 `tasks.json` / `launch.json`（只更新本扩展生成的那一条，其余配置保留）。若你习惯手改这两个文件，可关闭。"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run-tests.js",
    "icon": "node tools/make-icon.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  }
}
